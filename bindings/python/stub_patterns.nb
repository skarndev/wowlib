# nanobind stubgen PATTERN_FILE — the one part of the versioned-format facade's
# typing that stubgen cannot synthesize: the AnyX union aliases. Everything else is
# native — welded C++ bases give real inheritance/isinstance, nb::sig merged
# overloads render as typed @overload blocks, and stubgen auto-imports the
# typing/collections.abc/wowlib.fs names the sigs use. A new expansion adds one
# member to each union (alongside wmo_versions and WOWLIB_WMO_FOR_EACH_VERSION).

wowlib.formats.wmo.__prefix__:
    AnyWMO = WMOVanilla | WMOTbc | WMOWotlk | WMOCata | WMOMop | WMOWod | WMOLegion | WMOBfa | WMOShadowlands | WMODragonflight | WMOTheWarWithin

wowlib.formats.wmo.root.__prefix__:
    AnyWMORoot = WMORootVanilla | WMORootTbc | WMORootWotlk | WMORootCata | WMORootMop | WMORootWod | WMORootLegion | WMORootBfa | WMORootShadowlands | WMORootDragonflight | WMORootTheWarWithin

wowlib.formats.wmo.group.__prefix__:
    AnyWMOGroup = WMOGroupVanilla | WMOGroupTbc | WMOGroupWotlk | WMOGroupCata | WMOGroupMop | WMOGroupWod | WMOGroupLegion | WMOGroupBfa | WMOGroupShadowlands | WMOGroupDragonflight | WMOGroupTheWarWithin
    AnyWMOGroupBody = WMOGroupBodyVanilla | WMOGroupBodyTbc | WMOGroupBodyWotlk | WMOGroupBodyCata | WMOGroupBodyMop | WMOGroupBodyWod | WMOGroupBodyLegion | WMOGroupBodyBfa | WMOGroupBodyShadowlands | WMOGroupBodyDragonflight | WMOGroupBodyTheWarWithin

wowlib.formats.wmo.group_chunks.__prefix__:
    AnyWMOGroupHeader = WMOGroupHeaderVanilla | WMOGroupHeaderTbc | WMOGroupHeaderWotlk | WMOGroupHeaderCata | WMOGroupHeaderMop | WMOGroupHeaderWod | WMOGroupHeaderLegion | WMOGroupHeaderBfa | WMOGroupHeaderShadowlands | WMOGroupHeaderDragonflight | WMOGroupHeaderTheWarWithin
    AnyWMOBatch = WMOBatchVanilla | WMOBatchTbc | WMOBatchWotlk | WMOBatchCata | WMOBatchMop | WMOBatchWod | WMOBatchLegion | WMOBatchBfa | WMOBatchShadowlands | WMOBatchDragonflight | WMOBatchTheWarWithin
