# nanobind stubgen PATTERN_FILE — spells the AnyX union aliases in the stubs.
#
# The AnyX aliases are REAL runtime objects now: def_any_alias (facade.hpp) binds
# each as a types.UnionType (WMOVanilla | WMOTbc | ...) on its submodule, so
# `from wowlib.formats.wmo import AnyWMO` works and the alias supports isinstance.
# But nanobind 2.13's stubgen renders a types.UnionType as the INVALID subscript
# `types.UnionType[...]` (type_str: origin+args), which mypy rejects — so each entry
# below (a) suppresses that broken auto-emit by matching the attribute's full path
# and (b) writes the correct `AnyX = C0 | C1 | ...` alias instead.
#
# The `$` anchors the key so AnyWMOGroup does not also match AnyWMOGroupBody. This
# stub spelling is the one hand-maintained coupling point with wmo_versions + the
# X-macro: a new Expansion grows the runtime unions automatically (def_any_alias
# walks expansion_enumerators) but must be added to the matching line here too.
# check.py guards both halves — a runtime isinstance test and a mypy narrowing test.

wowlib.formats.wmo.AnyWMO$:
    AnyWMO = WMOVanilla | WMOTbc | WMOWotlk | WMOCata | WMOMop | WMOWod | WMOLegion | WMOBfa | WMOShadowlands | WMODragonflight | WMOTheWarWithin

wowlib.formats.wmo.root.AnyWMORoot$:
    AnyWMORoot = WMORootVanilla | WMORootTbc | WMORootWotlk | WMORootCata | WMORootMop | WMORootWod | WMORootLegion | WMORootBfa | WMORootShadowlands | WMORootDragonflight | WMORootTheWarWithin

wowlib.formats.wmo.group.AnyWMOGroup$:
    AnyWMOGroup = WMOGroupVanilla | WMOGroupTbc | WMOGroupWotlk | WMOGroupCata | WMOGroupMop | WMOGroupWod | WMOGroupLegion | WMOGroupBfa | WMOGroupShadowlands | WMOGroupDragonflight | WMOGroupTheWarWithin

wowlib.formats.wmo.group.AnyWMOGroupBody$:
    AnyWMOGroupBody = WMOGroupBodyVanilla | WMOGroupBodyTbc | WMOGroupBodyWotlk | WMOGroupBodyCata | WMOGroupBodyMop | WMOGroupBodyWod | WMOGroupBodyLegion | WMOGroupBodyBfa | WMOGroupBodyShadowlands | WMOGroupBodyDragonflight | WMOGroupBodyTheWarWithin

wowlib.formats.wmo.group.chunks.AnyWMOGroupHeader$:
    AnyWMOGroupHeader = WMOGroupHeaderVanilla | WMOGroupHeaderTbc | WMOGroupHeaderWotlk | WMOGroupHeaderCata | WMOGroupHeaderMop | WMOGroupHeaderWod | WMOGroupHeaderLegion | WMOGroupHeaderBfa | WMOGroupHeaderShadowlands | WMOGroupHeaderDragonflight | WMOGroupHeaderTheWarWithin

wowlib.formats.wmo.group.chunks.AnyWMOBatch$:
    AnyWMOBatch = WMOBatchVanilla | WMOBatchTbc | WMOBatchWotlk | WMOBatchCata | WMOBatchMop | WMOBatchWod | WMOBatchLegion | WMOBatchBfa | WMOBatchShadowlands | WMOBatchDragonflight | WMOBatchTheWarWithin

# Every wowlib exception carries `code` (the ErrorCode spelling) and `native_error`
# (the raw StormLib/CascLib/OS error). errors.cpp attaches these per-instance at raise
# time (raise_wowlib_error), so stubgen — which reflects classes — cannot see them.
# Spell them on the wowlib.Error base here; every ErrorCode subclass inherits the
# typing. Keep in sync with raise_wowlib_error if either attribute changes.
wowlib.Error$:
    class Error(Exception):
        code: str
        native_error: int


wowlib.formats.m2.AnyM2$:
    AnyM2 = M2Vanilla | M2Tbc | M2Wotlk | M2Cata | M2Mop | M2Wod | M2Legion | M2Bfa | M2Shadowlands | M2Dragonflight | M2TheWarWithin

