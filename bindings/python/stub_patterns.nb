# nanobind stubgen PATTERN_FILE — spells the AnyX union aliases in the stubs.
#
# The AnyX aliases are REAL runtime objects now: def_any_alias (facade.hpp) binds
# each as a types.UnionType (WMOVanilla | WMOTbc | ...) on its submodule, so
# `from wowlib.formats.wmo import AnyWMO` works and the alias supports isinstance.
# But nanobind 2.13's stubgen renders a types.UnionType as the INVALID subscript
# `types.UnionType[...]` (type_str: origin+args), which mypy rejects — so each entry
# below (a) suppresses that broken auto-emit by matching the attribute's full path
# and (b) writes the correct `AnyX = C0 | C1 | ...` alias instead.
#
# The `$` anchors the key so AnyWMOGroup does not also match AnyWMOGroupBody. This
# stub spelling is the one hand-maintained coupling point with the per-family
# RANGE tables (WOWLIB_*_RANGES_* in wmo.hpp/m2.hpp): one entry per range row,
# spelled with the same range suffix ("CataToMop", "LegionPlus"). A pivot/grid
# change moves the rows there (consteval-checked) and must be mirrored here;
# the pytest facade suites guard both halves.

wowlib.formats.wmo.AnyWMO$:
    AnyWMO = WMOVanillaToWotlk | WMOCataToMop | WMOWod | WMOLegion | WMOBfa | WMOShadowlands | WMODragonflight | WMOTheWarWithin

wowlib.formats.wmo.root.AnyWMORoot$:
    AnyWMORoot = WMORootVanillaToWod | WMORootLegion | WMORootBfa | WMORootShadowlandsToDragonflight | WMORootTheWarWithin

wowlib.formats.wmo.group.AnyWMOGroup$:
    AnyWMOGroup = WMOGroupVanillaToWotlk | WMOGroupCataToMop | WMOGroupWod | WMOGroupLegion | WMOGroupBfa | WMOGroupShadowlands | WMOGroupDragonflightPlus

wowlib.formats.wmo.group.AnyWMOGroupBody$:
    AnyWMOGroupBody = WMOGroupBodyVanillaToWotlk | WMOGroupBodyCataToMop | WMOGroupBodyWod | WMOGroupBodyLegion | WMOGroupBodyBfa | WMOGroupBodyShadowlands | WMOGroupBodyDragonflightPlus

wowlib.formats.wmo.group.chunks.AnyWMOGroupHeader$:
    AnyWMOGroupHeader = WMOGroupHeaderVanillaToBfa | WMOGroupHeaderShadowlandsPlus

wowlib.formats.wmo.group.chunks.AnyWMOBatch$:
    AnyWMOBatch = WMOBatchVanillaToWod | WMOBatchLegionPlus

# Every wowlib exception carries `code` (the ErrorCode spelling) and `native_error`
# (the raw StormLib/CascLib/OS error). errors.cpp attaches these per-instance at raise
# time (raise_wowlib_error), so stubgen — which reflects classes — cannot see them.
# Spell them on the wowlib.Error base here; every ErrorCode subclass inherits the
# typing. Keep in sync with raise_wowlib_error if either attribute changes.
wowlib.Error$:
    class Error(Exception):
        code: str
        native_error: int


wowlib.formats.m2.AnyM2$:
    AnyM2 = M2Vanilla | M2Tbc | M2Wotlk | M2CataToMop | M2Wod | M2Legion | M2Bfa | M2Shadowlands | M2Dragonflight | M2TheWarWithin

wowlib.formats.m2.body.AnyM2Data$:
    AnyM2Data = M2DataVanilla | M2DataTbc | M2DataWotlk | M2DataCataToMop | M2DataWod | M2DataLegionPlus

wowlib.formats.m2.skin.AnySkin$:
    AnySkin = SkinWotlk | SkinCataPlus

wowlib.formats.m2.body.AnyM2File$:
    AnyM2File = M2FileLegion | M2FileBfa | M2FileShadowlands | M2FileDragonflight | M2FileTheWarWithin

wowlib.formats.m2.AnySkeleton$:
    AnySkeleton = SkeletonLegionPlus
