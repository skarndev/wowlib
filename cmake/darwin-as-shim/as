#!/bin/sh
# Assembler shim for gcc-16 on aarch64-apple-darwin (see CompilerSettings.cmake).
#
# ROOT CAUSE
# GCC's Darwin port names string literals with assembler-*temporary* labels
# (L.str.N). Under .subsections_via_symbols a temporary label does not open a
# Mach-O atom, so the literal bytes are absorbed into the atom started by the
# preceding real symbol. When that symbol is coalescable (.weak_definition --
# e.g. the std::span<char>::__v<N> blobs C++26 reflection materializes in every
# TU that includes a wowlib header), ld keeps one TU's atom and drops the rest;
# every literal that rode along then resolves into the survivor at the same
# offset. Observed as std::format("{:016x}") returning NUL-riddled hex:
# libstdc++'s "0123456789abcdef" table sat at __v<256>+4 and moved when another
# TU's copy won the coalescing lottery.
#
# Clang does not have this bug because it names literals l_.str -- the
# lowercase-l "linker-private" class, which DOES open an atom yet is still
# stripped from the final image. GCC already gets this right for FP constants
# (it emits lCN); string literals are the gap. So: rename L.str.* -> l.str.*.
#
# UPSTREAM
# This is a GCC 16 regression, not long-standing behaviour. gcc/config/darwin.cc
# (darwin_encode_section_info) gained
#     buf = xasprintf ("*%c.str.%s", for_asan ? 'l' : 'L', &name[3]);
# in r16-2939-g4db9571488eb ("Darwin: Handle string constants specially when asan
# is enabled", 2025-08). GCC <= 15 had no such block and left string constants
# with the lowercase lC<N> name from ASM_GENERATE_INTERNAL_LABEL, whose comment in
# darwin.h says outright: "Make local constant labels linker-visible, so that if
# one follows a weak_global constant, ld64 will be able to separate the atoms."
# The same rationale is in the PR 71767 comment in machopic_indirection_name.
# So upstream already knows why uppercase L is unsafe next to weak definitions;
# the asan patch just reintroduced it for strings. As of 2026-08 this is
# unreported on GCC Bugzilla and unfixed on trunk -- the fix is to drop the
# conditional and always use 'l'.
#
# NOTE THE POLARITY -- it is the reverse of what the commit title suggests.
# for_asan is the branch that gets the SAFE lowercase 'l'; the ': L' fallback is
# the broken one, so *ordinary* builds are the affected ones and an asan build is
# accidentally correct. Verified on 16.1.0: -O2 emits L.str.0, -O2
# -fsanitize=address emits l.str.0. asan is not a usable workaround regardless --
# it relocates literals into __TEXT,__asan_cstring wholesale. No other command
# line option changes the prefix.
#
# EXPOSURE (why not every L.str matters)
# Only literals in *regular* sections are at risk. __TEXT,__cstring is a literal
# section: ld coalesces it by content and never atomizes it by symbol, so string
# literals landing there are safe even unshimmed. The damage is done by literals
# gcc emits into __TEXT,__const -- like libstdc++'s to_chars digit table, which
# is what actually broke -- since __const is atomized by symbol. That is why an
# unshimmed third-party TU full of __cstring literals is harmless while one
# instantiating <format>/<charconv> is not.
#
# WHY THE RENAME IS DELIBERATELY NARROW
# The blunt alternative -- `-Wa,-L`, telling the assembler to treat every
# temporary label as real -- also promotes local branch targets, and aarch64
# cannot relocate a conditional branch against an external symbol, so ordinary
# code stops assembling ("conditional branch requires assembler-local label").
# L.str.* is also the only temporary-label class that anchors data in a
# coalescable section: EH/CFI labels live in __eh_frame / GCC_except_table,
# which the linker handles separately, and FP constants are already lowercase.
#
# INVARIANTS THIS SCRIPT MUST HOLD (each was a live bug in the first cut)
#  1. Never edit the input in place. gcc hands us its own temp file for a C/C++
#     TU, but for a hand-written .s in the project it hands us the *source*.
#  2. Handle stdin. Under -pipe gcc invokes `as ... -o foo.o -` and there is no
#     file to rewrite at all; missing this silently disables the workaround and
#     the corruption comes straight back with no diagnostic.
#  3. Never rewrite .ascii/.asciz/.string operands. Those are program data, not
#     symbol references -- a C++ string containing "L.str." would otherwise be
#     silently corrupted by the very shim that exists to prevent silent
#     corruption.
#  4. Fail loudly. A shim that cannot do its job must not quietly assemble
#     anyway; the failure mode it guards against is invisible at runtime.
set -eu

real_as=/usr/bin/as
[ -x "$real_as" ] || { echo "darwin-as-shim: $real_as not found" >&2; exit 1; }

tmpdir=
cleanup() { [ -n "$tmpdir" ] && rm -rf "$tmpdir"; }
trap cleanup EXIT HUP INT TERM

die() { echo "darwin-as-shim: $*" >&2; exit 1; }

need_tmp() {
  [ -n "$tmpdir" ] && return 0
  tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/darwin-as-shim.XXXXXX") || die "cannot create temp dir"
}

# Invariant 3 is the `b` (branch-to-end-of-script) line. BSD sed has no \|
# alternation, hence -E.
rewrite() {
  /usr/bin/sed -E '
/^[[:space:]]*\.(ascii|asciz|string)/b
s/^L\.str\./l.str./
s/([^A-Za-z0-9_.$])L\.str\./\1l.str./g
'
}

# Rebuild "$@" in place, swapping each assembly input for a rewritten copy.
# Rotating the positional parameters exactly $# times is the POSIX-sh way to do
# this without arrays, and unlike xargs it preserves arguments containing
# spaces and lets us exec so the assembler's exit status passes through as-is.
# Values of -o/-arch are stepped over so an output named *.s is not mistaken
# for an input.
argc=$#
i=0
skip=0
while [ "$i" -lt "$argc" ]; do
  a=$1
  shift
  i=$((i + 1))

  if [ "$skip" = 1 ]; then
    skip=0
    set -- "$@" "$a"
    continue
  fi

  case "$a" in
    -o | -arch)
      skip=1
      ;;
    -)
      need_tmp
      rewrite > "$tmpdir/stdin.s" || die "failed rewriting stdin"
      a="$tmpdir/stdin.s"
      ;;
    *.s | *.S)
      if [ -r "$a" ]; then
        need_tmp
        out="$tmpdir/in$i.s"
        rewrite < "$a" > "$out" || die "failed rewriting $a"
        a="$out"
      fi
      ;;
  esac

  set -- "$@" "$a"
done

exec "$real_as" "$@"
