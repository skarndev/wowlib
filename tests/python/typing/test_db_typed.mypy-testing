"""Type-resolution cases for the typed DB stubs (the dbdgen per-era modules
plus the Table.open overloads merged into wowlib/db/__init__.pyi): era module
classes carry era-EXACT columns, Literal overloads of Table.open narrow to the
per-table union of era classes, and a non-literal table name stays generic."""

import pytest

import wowlib
import wowlib.db.tables.cata
import wowlib.db.tables.wotlk
from wowlib.db import Table


@pytest.mark.mypy_testing
def mypy_era_modules_type_rows_era_exactly() -> None:
    table = wowlib.db.tables.wotlk.Map()
    reveal_type(table)  # R: wowlib.db.tables.wotlk.Map
    reveal_type(table[0])  # R: wowlib.db.tables.wotlk.MapRecord
    reveal_type(table[0].directory)  # R: str
    reveal_type(table[0].id)  # R: int
    # map_name is genuinely era-dependent: LocString slots pre-Cata, a plain
    # string Cataclysm onwards — each era module carries the exact shape.
    reveal_type(table[0].map_name)  # R: list[str]
    reveal_type(wowlib.db.tables.cata.Map()[0].map_name)  # R: str
    for row in table:
        reveal_type(row.directory)  # R: str


@pytest.mark.mypy_testing
def mypy_open_narrows_on_the_table_literal() -> None:
    # The overload return is the union of the table's per-era classes, so
    # columns every era shares type precisely through it.
    table = Table.open("Map", wowlib.versions.wotlk)
    reveal_type(table[0].id)  # R: int
    reveal_type(table[0].directory)  # R: str


@pytest.mark.mypy_testing
def mypy_non_literal_names_stay_generic() -> None:
    name = "Map".strip()
    reveal_type(Table.open(name, wowlib.versions.wotlk))  # R: wowlib.db.Table[wowlib.db.Record]
    reveal_type(Table.open(name, wowlib.versions.wotlk)[0])  # R: wowlib.db.Record
