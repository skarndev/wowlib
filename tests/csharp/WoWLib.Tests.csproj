<!-- The C# binding tests, run against the generated Wowlib project of a C#
     build tree (which carries the compiled managed wrapper, the dbdgen db
     facades, the per-era format factories AND the native shim beside it):

         cmake ~preset gcc16-csharp && cmake ~build ~preset gcc16-csharp
         dotnet test tests/csharp

     (read `~` as the usual double-dash: XML comments cannot hold one.)
     A non-default tree overrides the reference:

         dotnet test tests/csharp -p:WowlibProject=/path/to/bindings/WoWLib/WoWLib.csproj
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Match the wrapper's TFM but run on whatever newer runtime the machine
         has (a dotnet 10 SDK need not carry the 8.0 runtime). -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <WowlibProject Condition="'$(WowlibProject)' == ''">$(MSBuildThisFileDirectory)../../build/csharp/bindings/WoWLib/WoWLib.csproj</WowlibProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(WowlibProject)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <!-- The native shim sits beside the generated project's parent directory
       (build/csharp/bindings/). Copy it explicitly: the transitive flow of the
       Wowlib project's copy-to-output item proved platform-flaky (worked on
       macOS, silently didn't on Linux CI). The glob matches whichever of
       libwowlib_native.so/.dylib / wowlib_native.dll this platform built and
       drops cleanly when none exists. -->
  <PropertyGroup>
    <WowlibNativeDir Condition="'$(WowlibNativeDir)' == ''">$([System.IO.Path]::GetFullPath('$([System.IO.Path]::GetDirectoryName('$(WowlibProject)'))/..'))</WowlibNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(WowlibNativeDir)/*wowlib_native.*" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
